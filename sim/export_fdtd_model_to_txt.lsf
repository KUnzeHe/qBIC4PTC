# Export editable settings of the currently open FDTD model.
# This script does not run the solver or change simulation objects.
# Run it in FDTD Solutions with the intended .fsp file already open.

clear;
format long;

# A relative path uses Lumerical's current working directory.
# Change to an absolute Windows path if you need a fixed output location.
export_file = "fdtd_model_complete_export.txt";

write(export_file, "LUMERICAL FDTD MODEL SETTINGS EXPORT", "overwrite");
write(export_file, "Geometry values are in SI units (metres)." + endl);
write(export_file, "This export contains model settings, not field/result arrays." + endl);

# Discover global source properties from the installed version.
write(export_file, "===== GLOBAL SOURCE SETTINGS =====");
global_source_error = "";
try {
    global_source_names = splitstring(getglobalsource, endl);
    for (j=1:length(global_source_names)) {
        property_name = global_source_names{j};
        if (length(property_name)>0) {
            read_error = "";
            try {
                property_value = getglobalsource(property_name);
                write(export_file, property_name + " = " + toscript(property_value, true));
            } catch(read_error);
            if (length(read_error)>0) {
                write(export_file, "[READ FAILED] " + property_name + ": " + read_error);
            }
        }
    }
} catch(global_source_error);
if (length(global_source_error)>0) {
    write(export_file, "[SECTION FAILED] " + global_source_error);
}

# Discover global monitor properties from the installed version.
write(export_file, "===== GLOBAL MONITOR SETTINGS =====");
global_monitor_error = "";
try {
    global_monitor_names = splitstring(getglobalmonitor, endl);
    for (j=1:length(global_monitor_names)) {
        property_name = global_monitor_names{j};
        if (length(property_name)>0) {
            read_error = "";
            try {
                property_value = getglobalmonitor(property_name);
                write(export_file, property_name + " = " + toscript(property_value, true));
            } catch(read_error);
            if (length(read_error)>0) {
                write(export_file, "[READ FAILED] " + property_name + ": " + read_error);
            }
        }
    }
} catch(global_monitor_error);
if (length(global_monitor_error)>0) {
    write(export_file, "[SECTION FAILED] " + global_monitor_error);
}

# Save root-level names before changing the selection.
groupscope("::model");
selectall;
object_count = getnumber;
object_names = cell(object_count);
for (i=1:object_count) {
    object_names{i} = get("name", i);
}
unselectall;

write(export_file, "===== ROOT OBJECTS: " + num2str(object_count) + " =====");
for (i=1:object_count) {
    object_name = object_names{i};
    object_path = "::model::" + object_name;
    write(export_file, "----- OBJECT " + num2str(i) + ": " + object_path + " -----");

    if (getnamednumber(object_path)>1) {
        write(export_file, "[WARNING] Duplicate name; values may refer to the first matching object.");
    }

    select(object_path);
    object_error = "";
    try {
        property_names = splitstring(get, endl);
        for (j=1:length(property_names)) {
            property_name = property_names{j};
            if (length(property_name)>0) {
                read_error = "";
                try {
                    property_value = get(property_name);
                    write(export_file, property_name + " = " + toscript(property_value, true));
                } catch(read_error);
                if (length(read_error)>0) {
                    write(export_file, "[READ FAILED] " + property_name + ": " + read_error);
                }
            }
        }
    } catch(object_error);
    if (length(object_error)>0) {
        write(export_file, "[OBJECT FAILED] " + object_error);
    }

    # Include database properties of materials referenced by this object.
    # Object-defined dielectric index is included in the object properties.
    material_error = "";
    try {
        material_name = get("material");
        if (materialexists(material_name)) {
            write(export_file, "----- MATERIAL: " + material_name + " -----");
            material_names = splitstring(getmaterial(material_name), endl);
            for (j=1:length(material_names)) {
                property_name = material_names{j};
                if (length(property_name)>0) {
                    read_error = "";
                    try {
                        property_value = getmaterial(material_name, property_name);
                        write(export_file, property_name + " = " + toscript(property_value, true));
                    } catch(read_error);
                    if (length(read_error)>0) {
                        write(export_file, "[MATERIAL READ FAILED] " + property_name + ": " + read_error);
                    }
                }
            }
        }
    } catch(material_error);
    if (length(material_error)>0) {
        write(export_file, "[MATERIAL SECTION FAILED] " + material_error);
    }

    # Current project uses root-level objects. If a group is added later,
    # its child objects require a separate export.
    type_error = "";
    try {
        object_type = get("type");
        if (findstring(lower(object_type), "group")!=-1) {
            write(export_file, "[WARNING] Nested group children are not exported.");
        }
    } catch(type_error);
}

unselectall;
groupscope("::model");
write(export_file, "===== END OF EXPORT =====");
?"Export finished: " + export_file;
?"Working directory: " + pwd;
