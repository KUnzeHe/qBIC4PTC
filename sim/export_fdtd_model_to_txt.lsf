# ============================================================
# Export all available FDTD model information to TXT
# Compatible with Lumerical FDTD scripting environment
# ============================================================

clear;

# ------------------------------------------------------------
# 输出文件路径
# ------------------------------------------------------------
filename = "fdtd_model_complete_export.txt";

# 如果希望指定绝对路径，可以改成例如：
# filename = "D:/LumericalExport/fdtd_model_complete_export.txt";

out = "";

out = out + "============================================================\n";
out = out + "Lumerical FDTD MODEL EXPORT\n";
out = out + "============================================================\n";
out = out + "Export time: not recorded\n";
out = out + "\n";

# ============================================================
# 工具函数
# ============================================================

# ------------------------------------------------------------
# 将一个属性读取并转换成文本
# 读取失败时自动跳过
# ------------------------------------------------------------
function s = read_property(object_path, property_name) {
    s = "";

    try {
        value = getnamed(object_path, property_name);

        # 对数值、矩阵、复数、字符串等尽可能转换
        try {
            value_text = num2str(value);
        } catch {
            value_text = value;
        }

        s = property_name + " = " + value_text + "\n";

    } catch {
        # 属性不存在或当前对象不支持该属性时跳过
        s = "";
    }
}


# ------------------------------------------------------------
# 尝试读取一组属性
# ------------------------------------------------------------
function s = read_property_list(object_path, property_list) {
    s = "";

    for (k=1:length(property_list)) {
        s = s + read_property(object_path, property_list(k));
    }
}


